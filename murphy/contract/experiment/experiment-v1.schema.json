{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MURPHY local experiment composition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "builds", "targets", "expected_requests", "timeout_seconds"],
  "properties": {
    "schema_version": {"const": "1"},
    "experiment_id": {"$ref": "../common/common-v1.schema.json#/$defs/id"},
    "builds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "targets": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/file"}},
    "template": {"$ref": "#/$defs/file"},
    "expected_requests": {"type": "integer", "minimum": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
  },
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "../common/common-v1.schema.json#/$defs/sha"}}
    }
  }
}
