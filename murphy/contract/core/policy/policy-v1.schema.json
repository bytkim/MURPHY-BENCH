{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MURPHY build policy format v1; recipe revisions are separate",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1"},
    "policy_id": {"const": "murphy"},
    "revision": {"type": "integer", "minimum": 1},
    "model": {
      "type": "object",
      "properties": {"repository": {"const": "Qwen/Qwen3.5-9B"}, "revision": {"$ref": "#/$defs/revision"}},
      "required": ["repository", "revision"], "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {"seed": {"type": "integer", "minimum": 0}, "method": {"const": "sha256-canonical-json-seed-namespace-id"}},
      "required": ["seed", "method"], "additionalProperties": false
    },
    "languages": {
      "type": "object",
      "properties": {
        "fixed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["eng_Latn", "rus_Cyrl", "spa_Latn", "arb_Arab", "jpn_Jpan"]}},
        "chinese": {"const": "higher-pooled-split-rate-ties-Hans"}
      },
      "required": ["fixed", "chinese"], "additionalProperties": false
    },
    "datasets": {
      "type": "object",
      "properties": {
        "flores_plus": {
          "type": "object",
          "properties": {"revision": {"$ref": "#/$defs/revision"}, "split": {"enum": ["dev", "devtest"]}, "probe_ids": {"$ref": "#/$defs/count"}, "prompt_revision": {"$ref": "#/$defs/count"}},
          "required": ["revision", "split", "probe_ids", "prompt_revision"], "additionalProperties": false
        },
        "belebele": {
          "type": "object",
          "properties": {"revision": {"$ref": "#/$defs/revision"}, "probe_ids": {"$ref": "#/$defs/count"}, "prompt_revision": {"$ref": "#/$defs/count"}},
          "required": ["revision", "probe_ids", "prompt_revision"], "additionalProperties": false
        },
        "unicode_emoji": {
          "type": "object",
          "properties": {
            "version": {"const": "17.0.0"}, "pool_per_family": {"$ref": "#/$defs/count"}, "prompt_revision": {"$ref": "#/$defs/count"},
            "grouping": {"oneOf": [
              {"type": "object", "properties": {"strategy": {"const": "single-entry-v1"}}, "required": ["strategy"], "additionalProperties": false},
              {"type": "object", "properties": {"strategy": {"const": "balanced-families-v1"}, "entries_per_family": {"$ref": "#/$defs/count"}}, "required": ["strategy", "entries_per_family"], "additionalProperties": false}
            ]}
          },
          "required": ["version", "pool_per_family", "grouping", "prompt_revision"], "additionalProperties": false
        }
      },
      "required": ["flores_plus", "belebele", "unicode_emoji"], "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "properties": {"trial": {"$ref": "#/$defs/profile"}, "full": {"$ref": "#/$defs/profile"}},
      "required": ["trial", "full"], "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "max_tokens": {"$ref": "#/$defs/count"},
        "repeats": {"type": "integer", "minimum": 2, "maximum": 10},
        "endpoints": {
          "description": "Ordered nonthinking request conditions over the same tasks. Omission preserves legacy native-only preparation.",
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": {"$ref": "../../common/common-v1.schema.json#/$defs/condition/properties/endpoint"}
        }
      },
      "required": ["max_tokens", "repeats"], "additionalProperties": false
    }
  },
  "required": ["schema_version", "policy_id", "revision", "model", "selection", "languages", "datasets", "profiles", "request"],
  "additionalProperties": false,
  "$defs": {
    "count": {"type": "integer", "minimum": 1},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "profile": {
      "type": "object",
      "properties": {"flores_ids": {"$ref": "#/$defs/count"}, "belebele_ids": {"$ref": "#/$defs/count"}, "emoji_tasks": {"$ref": "#/$defs/count"}},
      "required": ["flores_ids", "belebele_ids", "emoji_tasks"], "additionalProperties": false
    }
  }
}
