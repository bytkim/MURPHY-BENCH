{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1"},
    "records": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "properties": {
        "source": {"enum": ["flores_plus", "belebele", "unicode_emoji"]},
        "group": {"type": "string"},
        "text": {"type": "string"},
        "hf_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      },
      "required": ["source", "group", "text", "hf_ids"],
      "additionalProperties": false
    }}
  },
  "required": ["schema_version", "records"],
  "additionalProperties": false
}
